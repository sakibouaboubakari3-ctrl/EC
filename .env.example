DATABASE_URL="postgresql://user:password@ep-example-000000.region.aws.neon.tech/neondb?sslmode=require"
AUTH_SECRET="replace-with-openssl-rand-base64-32"
# Required for NextAuth v5 under `next start`/production mode; do not set this
# in an environment where the reverse proxy doesn't validate the Host header.
AUTH_TRUST_HOST=true
# Used to source stock photography/video for marketing page sections.
PEXELS_API_KEY="replace-with-your-pexels-api-key"
# Vercel Blob store for KYC document uploads (Storage tab -> Blob store -> .env.local).
BLOB_STORE_ID="replace-with-your-blob-store-id"
BLOB_READ_WRITE_TOKEN="replace-with-your-blob-read-write-token"
# Brevo (transactional email) API key.
BREVO_API_KEY="replace-with-your-brevo-api-key"
# Must be a sender email verified in your Brevo account, or sends will be rejected.
BREVO_SENDER_EMAIL="replace-with-a-brevo-verified-sender-email"
BREVO_SENDER_NAME="EspaceCredit"
# Absolute origin used to build asset URLs (e.g. the logo) inside emails, since
# email clients cannot load relative/localhost paths. Set to the real deployed
# URL in production.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
